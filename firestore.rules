rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped Admin Check (Verified email idlfxn@gmail.com)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'idlfxn@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint for Client Inquiries
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'serviceType', 'projectDetails']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 160 &&
             data.serviceType is string && data.serviceType.size() <= 100 &&
             data.projectDetails is string && data.projectDetails.size() <= 3000 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 100)) &&
             (!('status' in data) || (data.status in ['new', 'reviewed', 'scheduled', 'archived']));
    }

    // Validation Blueprint for Bootcamp Registrations
    function isValidRegistration(data) {
      return data.keys().hasAll(['name', 'email', 'phone']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 160 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40 &&
             (!('tuition' in data) || (data.tuition is string && data.tuition.size() <= 50)) &&
             (!('status' in data) || (data.status in ['reserved', 'confirmed', 'refunded']));
    }

    // Validation Blueprint for User Profiles
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 160 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // 1. Inquiries Collection (Public create with strict payload validation, Admin management)
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // 2. Bootcamp Registrations (Public create with strict payload validation, Admin management)
    match /bootcampRegistrations/{registrationId} {
      allow create: if isValidId(registrationId) && isValidRegistration(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // 3. User Profiles (Owner isolated read/write, Admin oversight)
    match /users/{userId} {
      allow create, update: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidUser(incoming());
      allow get: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
    }

    // 4. Connection validation ping endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
